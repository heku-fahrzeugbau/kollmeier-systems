    "test:visual": "npm run build --silent && node scripts/test-visual.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.5",
    "@tailwindcss/vite": "^4.3.1",
    "astro": "^7.4.12",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "playwright-core": "^1.65.1",
    "typescript": "^6.0.3"
  }
}
