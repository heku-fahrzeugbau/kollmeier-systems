---
import '../styles/global.css'
import StarField from '../components/StarField.astro'

interface Props {
  title?: string
  description?: string
  /** Deckkraft des Sternenfelds. Auf Textseiten bewusst niedriger. */
  starfieldOpacity?: number
  /** Formationen, die der Scroll durchläuft. Leer = ruhiges Feld ohne Muster. */
  starfieldFormations?: string
}

const {
  title = 'Kollmeier Systems — Konstruktion, Automatisierung & technische KI',
  description = 'Ingenieursleistungen aus Bielefeld: CAD-Konstruktion, Automatisierung, 3D-Druck und technische KI-Lösungen für kleine und mittlere Unternehmen.',
  starfieldOpacity = 0.82,
  starfieldFormations = 'field,grid,orbit,spiral,wave',
} = Astro.props

const ogImage = new URL('og-image.jpg', Astro.site).href
const canonical = new URL(Astro.url.pathname, Astro.site).href
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kollmeier Systems" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>
  </head>
  <body>
    <StarField mode="page" opacity={starfieldOpacity} formations={starfieldFormations} />
    <slot />
  </body>
</html>