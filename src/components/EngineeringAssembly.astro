    <path d="m360 208v33l25-6v-34z" fill="#d9350a" stroke="currentColor" stroke-width="2" />
    <path d="M372 217c28-11 43-4 64 8" fill="none" stroke="#11110f" stroke-width="3" stroke-dasharray="4 5" />

    <!-- Sicherheitsmarkierungen -->
    <path d="m186 296 44-11 18 9-44 11zM651 270l44-11 18 9-44 11z" fill="#ff4f1f" stroke="currentColor" stroke-width="1.5" />
    <path d="m194 294 8-2m8-2 8-2m8-2 8-2M659 268l8-2m8-2 8-2m8-2 8-2" stroke="#11110f" stroke-width="3" />
  </g>

  <!-- Explosionsdarstellung eines Aktuators -->
  <g class="assembly-exploded" stroke="currentColor">
    <path d="M682 128 607 179" fill="none" stroke-dasharray="4 6" />
    <path d="m684 96 52-13 31 16-52 14z" fill="url(#metal-top)" stroke-width="2" />
    <path d="m715 113v34l52-13V99z" fill="url(#metal-side)" stroke-width="2" />
    <path d="m684 96v34l31 17v-34z" fill="#bbb8b0" stroke-width="2" />
    <circle cx="722" cy="112" r="9" fill="#ff4f1f" stroke-width="2" />
    <path d="m650 130 25-6 15 8-25 6z" fill="#11110f" stroke-width="2" />
    <path d="M674 132l17-4M706 118l-16 4" fill="none" stroke-width="1" stroke-dasharray="3 4" />
  </g>

  <g class="assembly-callouts" font-family="var(--mono)">
    <g transform="translate(151 221)"><circle r="13" fill="#11110f" /><text x="0" y="4" text-anchor="middle" fill="#f3f0e8">A</text><path d="M14 0h58" stroke="currentColor" /><text x="79" y="4" fill="currentColor">LINEAR AXIS</text></g>
    <g transform="translate(700 63)"><circle r="13" fill="#ff4f1f" /><text x="0" y="4" text-anchor="middle" fill="#11110f">B</text><path d="M-14 0h-49" stroke="currentColor" /><text x="-162" y="4" fill="currentColor">ACTUATOR</text></g>
    <g transform="translate(594 350)"><circle r="13" fill="#11110f" /><text x="0" y="4" text-anchor="middle" fill="#f3f0e8">C</text><path d="M-14 0h-47" stroke="currentColor" /><text x="-152" y="4" fill="currentColor">FIXTURE</text></g>
  </g>
</svg>

<style>
  .assembly-notes,
  .assembly-dimension-copy { font: 500 11px var(--mono); letter-spacing: .11em; }
  .assembly-dimension-copy { font-size: 10px; }
  .assembly-dimensions { stroke-width: 1; opacity: .72; }
  .assembly-machine { transform-origin: 450px 245px; }
  .assembly-carriage { animation: carriage-cycle 7s var(--ease-in-out) infinite; }
  .assembly-exploded { animation: exploded-float 5s var(--ease-in-out) infinite; }
  .assembly-callouts { font-size: 9px; letter-spacing: .08em; }

  @keyframes carriage-cycle {
    0%, 18%, 82%, 100% { transform: translate(0); }
    42%, 58% { transform: translate(34px, -8px); }
  }

  @keyframes exploded-float {
    0%, 100% { transform: translate(0); }
    50% { transform: translate(5px, -3px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .assembly-carriage,
    .assembly-exploded { animation: none; }
  }
</style>
