---
/**
 * StarField — interaktives Sternenfeld auf Canvas 2D
 *
 * - Der Cursor stößt Sterne weg, eine Federkraft zieht sie zurück.
 * - Der Scroll-Fortschritt morpht das Feld durch Formationen.
 *
 * Zwei Modi:
 *   mode="section" (Default) — Canvas liegt absolut in der Eltern-Section.
 *     Voraussetzung: Elternelement hat position: relative.
 *     Fortschritt = wie weit diese Section durchs Fenster gescrollt ist.
 *   mode="page" — Canvas liegt fixiert hinter der ganzen Seite (z-index 0).
 *     Voraussetzung: Sections haben KEINEN deckenden Hintergrund, und der
 *     Inhalt liegt darüber (position: relative; z-index: 1).
 *
 * Beispiel (im Hero):
 *   <StarField formations="field,grid,orbit" zIndex={2} />
 *
 * Kein Framework, keine Dependencies.
 */
interface Props {
  mode?: 'section' | 'page';
  /** Formationen in Scroll-Reihenfolge: field | grid | ks | orbit | spiral | wave.
   *  Ein Name zweimal hintereinander lässt die Formation über den ganzen
   *  Abschnitt dazwischen stehen, statt sofort weiterzuwandern. */
  formations?: string;
  /** Fläche in px² pro Stern. Kleiner = mehr Sterne. Default 1050 */
  density?: number;
  /** Obergrenze der Sternanzahl (Performance-Bremse). Default 4200 */
  maxCount?: number;
  /** Wirkradius des Cursors in px — bewusst klein, der Cursor soll den Stern
   *  quasi berühren müssen. Default 55 */
  repelRadius?: number;
  /** Deckkraft des Feldes, 0–1. Default 1 */
  opacity?: number;
  /** Stapelebene des Canvas. Default 0 */
  zIndex?: number;
}
const {
  mode = 'section',
  formations = 'field,grid,ks,ks,spiral,wave',
  density = 1050,
  maxCount = 4200,
  repelRadius = 55,
  opacity = 1,
  zIndex = 0,
} = Astro.props;
---

<canvas
  class="starfield"
  aria-hidden="true"
  data-starfield
  data-mode={mode}
  data-formations={formations}
  data-density={density}
  data-max-count={maxCount}
  data-repel-radius={repelRadius}
  style={`opacity:${opacity};z-index:${zIndex};position:${mode === 'page' ? 'fixed' : 'absolute'}`}
></canvas>

<style>
  .starfield {
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>

<script>
  type Star = {
    seedX: number; seedY: number; depth: number;
    x: number; y: number; vx: number; vy: number;
    tx: number; ty: number; glow: number;
    phase: number; size: number; alpha: number; ci: number;
    twPhase: number; twSpeed: number; bright: boolean; pick: number;
  };
  type Formation = (s: Star, i: number, n: number, W: number, H: number) => void;

  /* Echte Sterne sind nicht weiss, sondern haben eine Farbtemperatur —
     von heissem Blauweiss bis zu kuehlem Orange. Die Verteilung ist ans
     blosse Auge angelehnt, nicht an die Haeufigkeit am echten Himmel.
     Die letzten beiden Eintraege sind die Markenfarben aus global.css. */
  const PALETTE: Array<{ rgb: string; w: number }> = [
    { rgb: '170,197,255', w: 0.05 }, // heisses Blauweiss
    { rgb: '212,226,255', w: 0.20 }, // blaeulich weiss
    { rgb: '248,247,255', w: 0.34 }, // weiss
    { rgb: '255,244,232', w: 0.18 }, // gelblich weiss
    { rgb: '255,222,190', w: 0.09 }, // orange
    { rgb: '255,96,56',   w: 0.09 }, // signal
    { rgb: '113,128,255', w: 0.05 }, // blueprint
  ];

  function pickColor(r: number) {
    let acc = 0;
    for (let i = 0; i < PALETTE.length; i++) {
      acc += PALETTE[i].w;
      if (r < acc) return i;
    }
    return PALETTE.length - 1;
  }

  /* ---------------- FORMATIONEN ----------------
     Jede Funktion schreibt die Zielposition von Stern i.
     Neues Muster = ein weiterer Eintrag in dieser Map.
     ------------------------------------------- */
  const FORMATIONS: Record<string, Formation> = {
    // freies Feld
    field: (s, _i, _n, W, H) => {
      s.tx = s.seedX * W;
      s.ty = s.seedY * H;
    },
    // Raster / Blueprint
    grid: (s, i, n, W, H) => {
      const cols = Math.max(6, Math.round(Math.sqrt(n * (W / H))));
      const rows = Math.ceil(n / cols);
      const gx = Math.min(W, H * 1.6) * 0.86;
      const gy = H * 0.78;
      const col = i % cols;
      const row = (i / cols) | 0;
      s.tx = W / 2 + (col / (cols - 1) - 0.5) * gx;
      s.ty = H / 2 + (row / Math.max(1, rows - 1) - 0.5) * gy;
    },
    // konzentrische Ringe
    orbit: (s, i, n, W, H) => {
      const rings = 5;
      const ring = i % rings;
      const idx = (i / rings) | 0;
      const per = Math.ceil(n / rings);
      const R = Math.min(W, H) * (0.13 + ring * 0.075);
      const a = (idx / per) * Math.PI * 2 + ring * 0.6;
      s.tx = W / 2 + Math.cos(a) * R * 1.35;
      s.ty = H / 2 + Math.sin(a) * R;
    },
    // Spirale / Galaxie
    spiral: (s, i, n, W, H) => {
      const arms = 3;
      const arm = i % arms;
      const t = i / n;
      const R = Math.sqrt(t) * Math.min(W, H) * 0.5;
      const a = t * Math.PI * 3.2 + (arm / arms) * Math.PI * 2 + s.seedX * 0.25;
      s.tx = W / 2 + Math.cos(a) * R * 1.4;
      s.ty = H / 2 + Math.sin(a) * R;
    },
    // Welle / Signal
    wave: (s, i, n, W, H) => {
      const bands = 4;
      const band = i % bands;
      const t = ((i / bands) | 0) / Math.ceil(n / bands);
      s.tx = W / 2 + (t - 0.5) * W * 1.05;
      s.ty =
        H / 2 +
        Math.sin(t * Math.PI * 4 + band * 0.55) * H * 0.2 +
        (band - (bands - 1) / 2) * H * 0.055;
    },
  };

  /* ---------------- STERN-SPRITES ----------------
     Ein Stern ist kein Kreis: winziger heller Kern + weiter, weicher Halo.
     Beides wird einmalig in ein Offscreen-Canvas gerendert und danach nur
     noch per drawImage skaliert gezeichnet — deutlich schaerfer als arc()
     und guenstiger als ein Farbverlauf pro Stern und Frame.
     --------------------------------------------- */
  /* Quellaufloesung der Sprites. Ein heller Stern wird bei hoher
     Pixeldichte mit ueber 110 Geraetepixeln gezeichnet — aus einer
     96er-Quelle waere das Hochskalieren und damit sichtbar weich. */
  const SPRITE = 160;

  function makeSprite(rgb: string, spikes: boolean) {
    const c = document.createElement('canvas');
    c.width = c.height = SPRITE;
    const g = c.getContext('2d')!;
    const m = SPRITE / 2;

    if (spikes) {
      // vier Beugungsstrahlen, wie sie eine Optik erzeugt
      g.save();
      g.filter = `blur(${(SPRITE * 0.0146).toFixed(2)}px)`;
      g.globalCompositeOperation = 'lighter';
      for (let k = 0; k < 2; k++) {
        const grad = g.createLinearGradient(k ? 0 : m, k ? m : 0, k ? SPRITE : m, k ? m : SPRITE);
        grad.addColorStop(0, `rgba(${rgb},0)`);
        grad.addColorStop(0.42, `rgba(${rgb},0.30)`);
        grad.addColorStop(0.5, `rgba(${rgb},0.75)`);
        grad.addColorStop(0.58, `rgba(${rgb},0.30)`);
        grad.addColorStop(1, `rgba(${rgb},0)`);
        g.fillStyle = grad;
        const t = SPRITE * 0.022;
        if (k) g.fillRect(m - t / 2, 0, t, SPRITE);
        else g.fillRect(0, m - t / 2, SPRITE, t);
      }
      g.restore();
    }

    // Kern + Halo: steiler Abfall innen, langer flacher Ausklang aussen
    const grad = g.createRadialGradient(m, m, 0, m, m, m);
    grad.addColorStop(0.0, `rgba(${rgb},1)`);
    grad.addColorStop(0.035, `rgba(${rgb},0.95)`);
    grad.addColorStop(0.085, `rgba(${rgb},0.52)`);
    grad.addColorStop(0.17, `rgba(${rgb},0.17)`);
    grad.addColorStop(0.34, `rgba(${rgb},0.055)`);
    grad.addColorStop(0.62, `rgba(${rgb},0.015)`);
    grad.addColorStop(1.0, `rgba(${rgb},0)`);
    g.globalCompositeOperation = 'lighter';
    g.fillStyle = grad;
    g.fillRect(0, 0, SPRITE, SPRITE);
    return c;
  }

  let SPRITES: Array<{ plain: HTMLCanvasElement; bright: HTMLCanvasElement }> | null = null;
  function sprites() {
    if (!SPRITES) {
      SPRITES = PALETTE.map((c) => ({ plain: makeSprite(c.rgb, false), bright: makeSprite(c.rgb, true) }));
    }
    return SPRITES;
  }

  /* ---------------- SCHRIFT ALS FORMATION ----------------
     Der Schriftzug wird in ein kleines Offscreen-Canvas gerendert, dessen
     Seitenverhaeltnis dem Fenster entspricht. Danach werden die gesetzten
     Pixel als normierte Zielpunkte eingesammelt; jeder Stern greift sich
     davon deterministisch einen. Pro Fenstergroesse einmal berechnet.
     ----------------------------------------------------- */
  let textCache: { key: string; pts: number[] } = { key: '', pts: [] };

  function textPoints(text: string, W: number, H: number) {
    /* Hoehe grob gerastert: mobile Browser aendern sie beim Scrollen staendig
       um 60-100 px, weil die Adressleiste ein- und ausfaehrt. Auf die Pixel
       genau zu cachen hiesse, den Schriftzug dabei jedes Mal neu zu rastern. */
    const key = `${text}|${Math.round(W)}x${Math.round(H / 120) * 120}`;
    if (textCache.key === key) return textCache.pts;

    const sw = 480;
    const sh = Math.max(120, Math.min(1200, Math.round((sw * H) / Math.max(1, W))));
    const c = document.createElement('canvas');
    c.width = sw;
    c.height = sh;
    const g = c.getContext('2d', { willReadFrequently: true })!;
    g.textAlign = 'center';
    g.textBaseline = 'middle';
    g.fillStyle = '#fff';

    let size = sh * 0.58;
    const setFont = () => {
      g.font = `700 ${size}px Arial, Helvetica, sans-serif`;
      return g.measureText(text).width;
    };
    /* Bewusst kompakt: die Zahl der Sterne ist fest, also entscheidet die
       Groesse des Schriftzugs, wie dicht die Striche besetzt sind. Zu gross
       und die Buchstaben zerfallen in lose Punktwolken.

       Der Anteil haengt am Seitenverhaeltnis: "KS" ist eine breite, niedrige
       Form. Auf einem hochkanten Display schrumpft sie bei festem Anteil in
       sich zusammen — bei 390x844 waren es 46 % der Breite, aber nur 14 % der
       Hoehe, ein unlesbarer Klumpen. Schmale Viewports brauchen deshalb einen
       deutlich groesseren Anteil. */
    const maxW = sw * (W / H < 1.1 ? 0.82 : 0.46);
    if (setFont() > maxW) size *= maxW / setFont();
    try {
      // Mehr Luft zwischen K und S: aus Sternen gebaut laufen enge
      // Buchstaben sonst zu einer Wolke zusammen
      (g as CanvasRenderingContext2D & { letterSpacing: string }).letterSpacing = `${size * 0.09}px`;
    } catch {
      /* aeltere Browser koennen kein letterSpacing — dann eben ohne */
    }
    setFont();
    g.fillText(text, sw / 2, sh / 2);

    const d = g.getImageData(0, 0, sw, sh).data;
    const pts: number[] = [];
    for (let y = 0; y < sh; y++) {
      for (let x = 0; x < sw; x++) {
        if (d[(y * sw + x) * 4 + 3] > 140) pts.push(x / sw, y / sh);
      }
    }
    textCache = { key, pts };
    return pts;
  }

  // Schriftzug als Zielformation — greift auf FORMATIONS zu, sobald es steht
  FORMATIONS.ks = (s, i, n, W, H) => {
    const pts = textPoints('KS', W, H);
    const count = pts.length >> 1;
    if (count === 0) {
      s.tx = W / 2;
      s.ty = H / 2;
      return;
    }
    /* Gleichmaessig ueber die Glyphenpixel verteilen statt zufaellig greifen:
       zufaelliges Greifen erzeugt Klumpen und Loecher, und die Buchstaben
       zerfallen. Der Versatz aus s.pick bricht nur die Rasterkanten auf. */
    const stride = count / n;
    let k = Math.round(i * stride + (s.pick - 0.5) * stride);
    if (k < 0) k = 0;
    else if (k >= count) k = count - 1;
    k *= 2;
    s.tx = pts[k] * W;
    s.ty = pts[k + 1] * H;
  };

  const smoothstep = (t: number) => t * t * (3 - 2 * t);
  const clamp01 = (t: number) => (t < 0 ? 0 : t > 1 ? 1 : t);

  /** deterministischer Zufall — ein Resize würfelt das Feld nicht neu */
  function rand(seed: number) {
    let t = (seed + 0x6d2b79f5) | 0;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  }

  function initStarField(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d', { alpha: true });
    if (!ctx) return;

    const ds = canvas.dataset;
    const pageMode = ds.mode === 'page';
    const host = canvas.parentElement;

    const steps = (ds.formations || 'field')
      .split(',')
      .map((k) => FORMATIONS[k.trim()])
      .filter(Boolean);
    if (steps.length === 0) steps.push(FORMATIONS.field);

    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const coarse = matchMedia('(pointer: coarse)').matches;

    const CFG = {
      density: Number(ds.density) || 1050,
      maxCount: Number(ds.maxCount) || 4200,
      /* Untergrenze: auf kleinen Viewports greift sonst nur die Flaechenrechnung
         und das Feld wirkt leer gefegt. Sie bestimmt dort ausserdem, wie gut
         der KS-Schriftzug besetzt ist — bei 320 Sternen blieb er ein Fleck. */
      minCount: 1100,
      maxDpr: 2.5,
      repelRadius: Number(ds.repelRadius) || 55,
      repelForce: 12,   // Stärke der Abstoßung
      spring: 0.014,    // Rückstellkraft zur Zielposition
      damping: 0.87,    // Reibung — kleiner = beruhigt sich schneller
      driftAmp: coarse ? 9 : 16,   // Eigenleben im Stillstand
      driftSpeed: 0.00022,
      morphEase: coarse ? 0.045 : 0.06, // Trägheit beim Formationswechsel
      /* Obergrenze, wie weit der Formationsfortschritt wandern darf — als
         Anteil pro SEKUNDE, nicht pro Frame. Pro Frame gerechnet greift die
         Bremse auf einem 144-Hz-Display nur halb so stark wie auf 60 Hz.
         Ohne sie zieht ein schneller Wisch das halbe Feld quer über den
         Bildschirm — auf dem Handy der Hauptgrund für unruhige Sterne. */
      morphMaxRate: coarse ? 0.5 : 20,
    };

    let W = 0, H = 0, dpr = 1, sizeScale = 1;
    let builtW = 0, builtH = 0; // Maße, für die das Feld zuletzt aufgebaut wurde
    let stars: Star[] = [];
    const mouse = { x: -9999, y: -9999, tx: -9999, ty: -9999, active: false };
    let scrollTarget = 0, scrollEased = 0;
    let raf = 0, running = false, visible = true;
    let lastFrame = 0;

    function build() {
      let n = Math.round((W * H) / CFG.density);
      if (coarse) n = Math.round(n * 0.55);
      n = Math.max(CFG.minCount, Math.min(CFG.maxCount, n));

      /* Vorhandene Sterne behalten ihre Position, nur auf die neuen Maße
         umgerechnet. Sonst schnappt bei jedem Neuaufbau das ganze Feld
         zurück auf die Startpositionen. */
      const alt = stars;
      const skalaX = builtW ? W / builtW : 1;
      const skalaY = builtH ? H / builtH : 1;

      stars = new Array(n);
      for (let i = 0; i < n; i++) {
        const r1 = rand(i * 8), r2 = rand(i * 8 + 1), r3 = rand(i * 8 + 2);
        const r4 = rand(i * 8 + 3), r5 = rand(i * 8 + 4), r6 = rand(i * 8 + 5);
        const r7 = rand(i * 8 + 6), r8 = rand(i * 8 + 7);
        const depth = 0.35 + r3 * 0.65; // 0.35 = fern, 1 = nah
        const vorher = alt[i];
        stars[i] = {
          seedX: r1, seedY: r2, depth,
          x: vorher ? vorher.x * skalaX : r1 * W,
          y: vorher ? vorher.y * skalaY : r2 * H,
          vx: vorher ? vorher.vx : 0,
          vy: vorher ? vorher.vy : 0,
          tx: 0, ty: 0, glow: 0,
          phase: r3 * Math.PI * 2,
          // Groesse und Helligkeit potenziert: viele schwache, wenige starke
          size: 0.35 + Math.pow(r5, 1.7) * 1.55 * (0.55 + depth * 0.45),
          alpha: 0.1 + Math.pow(r5, 2.1) * 0.9,
          ci: pickColor(r4),
          twPhase: r6 * Math.PI * 2,
          twSpeed: 0.0004 + r6 * 0.0011,
          bright: r7 > 0.955,
          pick: r8,
        };
      }
    }

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, CFG.maxDpr);
      if (coarse) dpr = Math.min(dpr, 2);
      W = canvas.clientWidth;
      H = canvas.clientHeight;
      if (W === 0 || H === 0) return;
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.imageSmoothingQuality = 'high';
      /* Auf schmalen Viewports muessen die Sterne kleiner werden. Sie haetten
         sonst dieselbe physische Groesse wie am Desktop, waehrend die Striche
         des KS-Schriftzugs nur einen Bruchteil so breit sind — die Halos
         ueberstrahlen dann die Buchstabenform. Nebenbei wirkt das Feld auf
         dichten Displays feiner. */
      sizeScale = Math.max(0.45, Math.min(1, W / 900));
      /* Nur neu aufbauen, wenn sich die Breite ändert oder die Höhe deutlich.
         Mobile Browser feuern resize bei jedem Ein- und Ausfahren der
         Adressleiste — dort jedes Mal neu aufzubauen ließ das ganze Feld
         springen (gemessen: 85-fache Bewegung gegenüber dem Ruhezustand). */
      if (builtW === 0 || W !== builtW || Math.abs(H - builtH) > builtH * 0.3) {
        build();
        builtW = W;
        builtH = H;
      }
      // Glyphenpunkte gleich hier berechnen statt beim ersten Scrollen in die
      // Formation — sonst kostet das getImageData mitten im Scrollen ein Frame
      if (steps.includes(FORMATIONS.ks)) textPoints('KS', W, H);
      if (reduceMotion) drawStatic();
    }

    /** 0 → 1 über die Seite bzw. über die eigene Section */
    function scrollProgress() {
      if (pageMode) {
        const max = document.documentElement.scrollHeight - innerHeight;
        return max > 0 ? clamp01(scrollY / max) : 0;
      }
      const el = host || canvas;
      const r = el.getBoundingClientRect();
      return clamp01(-r.top / Math.max(1, r.height));
    }

    /** Zielposition = weiche Mischung zweier benachbarter Formationen */
    function applyTargets(progress: number, time: number) {
      const n = stars.length;
      const f = progress * (steps.length - 1);
      const i0 = Math.min(steps.length - 1, Math.floor(f));
      const i1 = Math.min(steps.length - 1, i0 + 1);
      const k = smoothstep(f - i0);
      const fa = steps[i0], fb = steps[i1];

      for (let i = 0; i < n; i++) {
        const s = stars[i];
        fa(s, i, n, W, H);
        const ax = s.tx, ay = s.ty;
        if (i1 !== i0 && k > 0) {
          fb(s, i, n, W, H);
          s.tx = ax + (s.tx - ax) * k;
          s.ty = ay + (s.ty - ay) * k;
        } else {
          s.tx = ax;
          s.ty = ay;
        }
        const d = CFG.driftAmp * s.depth;
        s.tx += Math.cos(time * CFG.driftSpeed + s.phase) * d;
        s.ty += Math.sin(time * CFG.driftSpeed * 1.3 + s.phase * 1.7) * d;
      }
    }

    function step(time: number) {
      raf = requestAnimationFrame(step);

      // Zeit seit dem letzten Frame, gedeckelt gegen Sprünge nach Tab-Wechseln
      const dt = lastFrame ? Math.min(0.05, (time - lastFrame) / 1000) : 0.016;
      lastFrame = time;

      const morphDelta = (scrollTarget - scrollEased) * CFG.morphEase;
      const grenze = CFG.morphMaxRate * dt;
      scrollEased += morphDelta > grenze ? grenze : morphDelta < -grenze ? -grenze : morphDelta;
      applyTargets(scrollEased, time);

      mouse.x += (mouse.tx - mouse.x) * 0.18;
      mouse.y += (mouse.ty - mouse.y) * 0.18;

      const R = mouse.active ? CFG.repelRadius : 0;
      const R2 = R * R;

      for (let i = 0; i < stars.length; i++) {
        const s = stars[i];

        // Cursor-Abstoßung: quadratischer Falloff, tiefenabhängig
        s.glow = 0;
        if (R2 > 0) {
          const dx = s.x - mouse.x;
          const dy = s.y - mouse.y;
          const d2 = dx * dx + dy * dy;
          if (d2 < R2 && d2 > 0.001) {
            const d = Math.sqrt(d2);
            const falloff = 1 - d / R;
            const force = falloff * falloff * CFG.repelForce * s.depth;
            s.vx += (dx / d) * force;
            s.vy += (dy / d) * force;
            s.glow = falloff;
          }
        }

        // Feder zurück in die Formation
        const kk = CFG.spring * (0.6 + s.depth * 0.7);
        s.vx += (s.tx - s.x) * kk;
        s.vy += (s.ty - s.y) * kk;

        s.vx *= CFG.damping;
        s.vy *= CFG.damping;
        s.x += s.vx;
        s.y += s.vy;
      }

      draw(time);
    }

    /* Gezeichnet wird in Batches: gleiche Farbe + gleiche Helligkeitsstufe
       teilen sich einen globalAlpha-Wert, damit pro Frame nur ~70 statt
       ~2000 Zustandswechsel anfallen. */
    const ALPHA_STEPS = 12;
    const batches: number[][] = [];
    for (let i = 0; i < PALETTE.length * 2 * ALPHA_STEPS; i++) batches.push([]);

    function draw(time: number) {
      ctx.clearRect(0, 0, W, H);
      // additiv: überlappende Halos summieren sich, wie echtes Sternenlicht
      ctx.globalCompositeOperation = 'lighter';
      for (let b = 0; b < batches.length; b++) batches[b].length = 0;

      for (let i = 0; i < stars.length; i++) {
        const s = stars[i];
        // Zwei ueberlagerte Frequenzen: das Funkeln wird unregelmaessig,
        // statt gleichmaessig zu pulsieren
        const tw =
          0.7 +
          0.19 * Math.sin(time * s.twSpeed + s.twPhase) +
          0.11 * Math.sin(time * s.twSpeed * 2.7 + s.twPhase * 1.9);
        const a = Math.min(1, s.alpha * tw + s.glow * 0.75);
        if (a <= 0.012) continue;
        const bucket = Math.min(ALPHA_STEPS - 1, (a * ALPHA_STEPS) | 0);
        batches[(s.ci * 2 + (s.bright ? 1 : 0)) * ALPHA_STEPS + bucket].push(i);
      }

      const sp = sprites();
      for (let k = 0; k < batches.length; k++) {
        const list = batches[k];
        if (list.length === 0) continue;
        const bucket = k % ALPHA_STEPS;
        const rest = (k / ALPHA_STEPS) | 0;
        const bright = (rest & 1) === 1;
        const img = bright ? sp[rest >> 1].bright : sp[rest >> 1].plain;
        ctx.globalAlpha = (bucket + 0.5) / ALPHA_STEPS;
        for (let j = 0; j < list.length; j++) {
          const s = stars[list[j]];
          const r = s.size * sizeScale * (bright ? 12 : 8) * (1 + s.glow * 1.2);
          ctx.drawImage(img, s.x - r, s.y - r, r * 2, r * 2);
        }
      }

      ctx.globalAlpha = 1;
      ctx.globalCompositeOperation = 'source-over';
    }

    function drawStatic() {
      applyTargets(scrollProgress(), 0);
      for (const s of stars) {
        s.x = s.tx;
        s.y = s.ty;
        s.glow = 0;
      }
      draw(0);
    }

    function start() {
      if (!running && visible && !reduceMotion) {
        running = true;
        lastFrame = 0; // nach einer Pause nicht mit einem Riesen-dt weiterrechnen
        raf = requestAnimationFrame(step);
      }
    }
    function stop() {
      if (running) {
        running = false;
        cancelAnimationFrame(raf);
      }
    }

    // Im Section-Modus nur rechnen, solange die Section im Bild ist
    if (!pageMode && 'IntersectionObserver' in window) {
      new IntersectionObserver(
        ([entry]) => {
          visible = entry.isIntersecting;
          visible ? start() : stop();
        },
        { rootMargin: '120px' }
      ).observe(host || canvas);
    }

    addEventListener('resize', resize, { passive: true });
    addEventListener(
      'scroll',
      () => {
        scrollTarget = scrollProgress();
        if (reduceMotion) drawStatic();
      },
      { passive: true }
    );

    if (!coarse) {
      addEventListener(
        'pointermove',
        (e) => {
          const r = canvas.getBoundingClientRect();
          const x = e.clientX - r.left;
          const y = e.clientY - r.top;
          if (!mouse.active) {
            mouse.x = x;
            mouse.y = y;
          }
          mouse.tx = x;
          mouse.ty = y;
          mouse.active = true;
        },
        { passive: true }
      );
      document.addEventListener('mouseleave', () => {
        mouse.active = false;
      });
    }

    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));

    resize();
    scrollTarget = scrollEased = scrollProgress();
    start();
  }

  document
    .querySelectorAll<HTMLCanvasElement>('canvas[data-starfield]')
    .forEach(initStarField);
</script>
