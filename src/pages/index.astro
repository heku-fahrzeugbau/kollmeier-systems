---
import Layout from '../layouts/Layout.astro'
import EngineeringAssembly from '../components/EngineeringAssembly.astro'

const services = [
  { number: '01', title: 'CAD & Konstruktion', text: 'Fertigungsgerechte Bauteile, Baugruppen und Sonderlösungen — parametrisch aufgebaut, nachvollziehbar dokumentiert und auf die reale Produktion ausgerichtet.', meta: ['SolidWorks', 'Fusion 360', 'DFAM'], code: 'CAD.01' },
  { number: '02', title: 'Automatisierung', text: 'Technische Konzepte und konstruktive Umsetzung für Maschinen, Vorrichtungen und Abläufe, die wiederholbar, wartbar und wirtschaftlich funktionieren.', meta: ['Konzept', 'Konstruktion', 'Prozess'], code: 'AUT.02' },
  { number: '03', title: '3D-Druck & Prototyping', text: 'Von der Werkstoff- und Verfahrenswahl bis zum belastbaren Prototypen. Mit Fokus auf sinnvolle Anwendungen statt 3D-Druck um jeden Preis.', meta: ['FDM', 'Prototypen', 'Kleinserien'], code: 'DFAM.03' },
  { number: '04', title: 'Technische KI-Lösungen', text: 'KI und Automatisierung für technische Workflows: Daten strukturieren, wiederkehrende Arbeit reduzieren und vorhandenes Wissen nutzbar machen.', meta: ['Workflows', 'Integration', 'Beratung'], code: 'AI.04' },
]

const process = [
  ['01', 'Verstehen', 'Aufgabe, Randbedingungen und gewünschtes Ergebnis sauber festhalten.'],
  ['02', 'Entwickeln', 'Lösungswege bewerten und eine belastbare technische Richtung ausarbeiten.'],
  ['03', 'Umsetzen', 'Konstruktion, Prototyp oder Workflow konkret und prüfbar realisieren.'],
  ['04', 'Übergeben', 'Ergebnis dokumentieren, abstimmen und für den Einsatz vorbereiten.'],
]
---

<Layout bodyClass="site-theme">
  <header class="site-header" data-header>
    <nav class="nav shell" aria-label="Hauptnavigation">
      <a href="#top" class="brand" aria-label="Kollmeier Systems Startseite">
        <svg class="brand-mark" viewBox="0 0 38 38" aria-hidden="true"><path d="M4 4h12v5H9v20h7v5H4zM34 4H22v5h7l-10 9 10 11h-7v5h12V29L24 18l10-9z" /></svg>
        <span class="brand-name">Kollmeier <b>Systems</b></span>
      </a>
      <div class="nav-links" id="nav-links">
        <a href="#leistungen"><span>01</span>Leistungen</a>
        <a href="#prozess"><span>02</span>Vorgehen</a>
        <a href="#ueber-mich"><span>03</span>Über mich</a>
      </div>
      <a href="#kontakt" class="nav-cta">Projekt anfragen <span aria-hidden="true">↗</span></a>
      <button class="nav-toggle" id="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-links" aria-label="Menü öffnen"><span></span><span></span></button>
    </nav>
  </header>

  <main id="main-content">
    <section class="hero" id="top">
      <div class="hero-orbit" aria-hidden="true"><span class="orbit orbit--1"></span><span class="orbit orbit--2"></span><span class="orbit orbit--3"></span></div>
      <div class="hero-rail hero-rail--left" aria-hidden="true"><span>KS / ENGINEERING</span><i></i><span>BIELEFELD · DE</span></div>
      <div class="hero-rail hero-rail--right" aria-hidden="true"><span>CAD</span><span>AUTOMATION</span><span>DFAM</span><span>AI</span></div>

      <div class="shell hero-shell">
        <div class="hero-kicker enter" style="--delay: 40ms"><span class="status-dot"></span><span>Engineering für konkrete Aufgaben</span><span class="hero-index">00 / KS</span></div>
        <div class="hero-copy">
          <h1 class="enter" style="--delay: 100ms">Aus Ideen werden <span><em>funktionierende</em> Systeme.</span></h1>
          <div class="hero-summary enter" style="--delay: 180ms">
            <p>Konstruktion, Automatisierung und technische KI-Lösungen für Unternehmen, die ein konkretes Problem sauber gelöst brauchen.</p>
            <a href="#kontakt" class="button button--primary">Projekt unverbindlich besprechen <span aria-hidden="true">↗</span></a>
          </div>
        </div>

        <div class="hero-machine enter" style="--delay: 220ms" data-machine aria-hidden="true">
          <EngineeringAssembly />
          <div class="machine-label machine-label--a"><span>A</span> Systementwurf</div>
          <div class="machine-label machine-label--b"><span>B</span> Automatisiert</div>
          <div class="machine-readout"><span>READY</span><b>01</b></div>
        </div>

        <div class="hero-credentials enter" style="--delay: 300ms" aria-label="Qualifikationen"><span>M.Sc. Wirtschaftsingenieurwesen</span><span>B.Eng. Elektrotechnik</span><span>Zertifizierter KI-Manager</span></div>
      </div>
    </section>

    <section id="leistungen" class="section services">
      <div class="shell">
        <div class="section-heading reveal" data-reveal>
          <p class="section-label"><span>01</span> Leistungsfelder</p>
          <h2>Technik ohne <em>Umwege.</em></h2>
          <p>Ich unterstütze dort, wo Konstruktion, Fertigung und digitale Werkzeuge zusammenkommen — vom ersten Konzept bis zu einer Lösung, die im Alltag Bestand hat.</p>
        </div>
        <div class="service-list">
          {services.map((service, index) => (
            <article class="service-card reveal" data-reveal style={`--delay: ${index * 60}ms`}>
              <div class="service-top"><span>{service.number}</span><code>{service.code}</code></div>
              <h3>{service.title}</h3><p>{service.text}</p>
              <ul aria-label={`Schwerpunkte ${service.title}`}>{service.meta.map((item) => <li>{item}</li>)}</ul>
              <span class="service-cross" aria-hidden="true"></span>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="statement" aria-label="Arbeitsweise">
      <div class="statement-track" aria-hidden="true"><span>KONSTRUIEREN · PRÜFEN · VERBESSERN ·</span><span>KONSTRUIEREN · PRÜFEN · VERBESSERN ·</span></div>
      <div class="shell statement-copy reveal" data-reveal><span class="section-label"><span>KS</span> Prinzip</span><p>Nicht mehr Technik als nötig.<br /><em>Aber so viel Präzision wie erforderlich.</em></p></div>
    </section>

    <section id="prozess" class="section process">
      <div class="shell process-grid">
        <div class="process-intro reveal" data-reveal>
          <p class="section-label"><span>02</span> Vorgehen</p><h2>Vom Problem zur belastbaren Lösung.</h2>
          <p>Keine aufgeblähten Workshops. Wir klären zuerst, was wirklich gebraucht wird, und arbeiten dann in nachvollziehbaren Schritten auf ein nutzbares Ergebnis hin.</p>
          <div class="process-meter" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
        </div>
        <ol class="process-list">
          {process.map(([number, title, text], index) => (
            <li class="reveal" data-reveal style={`--delay: ${index * 60}ms`}><span class="process-number">{number}</span><div><h3>{title}</h3><p>{text}</p></div><span class="process-arrow" aria-hidden="true">↘</span></li>
          ))}
        </ol>
      </div>
    </section>

    <section id="ueber-mich" class="section about">
      <div class="shell about-grid">
        <div class="about-title reveal" data-reveal><p class="section-label"><span>03</span> Über mich</p><h2>Ingenieurdenken trifft digitale Werkzeuge.</h2></div>
        <div class="about-body reveal" data-reveal style="--delay: 80ms">
          <p class="about-lead">Ich bin Robin Kollmeier, Wirtschaftsingenieur und Elektrotechniker aus Bielefeld.</p>
          <p>Mein Schwerpunkt liegt dort, wo technische Entwicklung praktisch werden muss: in CAD-Modellen, Maschinenkonzepten, Prototypen und automatisierten Abläufen. Moderne KI-Werkzeuge setze ich gezielt ein — als Verstärker guter Prozesse, nicht als Selbstzweck.</p>
          <dl class="credentials">
            <div><dt>01</dt><dd><strong>M.Sc. Wirtschaftsingenieurwesen</strong><span>CAD · Design for Additive Manufacturing</span></dd></div>
            <div><dt>02</dt><dd><strong>B.Eng. Elektrotechnik</strong><span>Schwerpunkt Automatisierungstechnik</span></dd></div>
            <div><dt>03</dt><dd><strong>Zertifizierter KI-Manager</strong><span>Technische Prozesse · KI-Integration</span></dd></div>
          </dl>
        </div>
      </div>
    </section>

    <section id="kontakt" class="contact">
      <div class="contact-grid" aria-hidden="true"></div>
      <div class="shell contact-grid-layout">
        <div class="contact-copy reveal" data-reveal>
          <p class="section-label section-label--light"><span>04</span> Kontakt</p><h2>Welches technische Problem soll als Nächstes gelöst werden?</h2>
          <p>Ein paar Stichpunkte reichen für den Anfang. Ich melde mich persönlich und kläre mit dir, ob und wie ich sinnvoll unterstützen kann.</p>
          <div class="direct-contact"><span>Direkter Kontakt</span><a href="mailto:kollmeier.robin@gmail.com">kollmeier.robin@gmail.com <b aria-hidden="true">↗</b></a><small>Bielefeld · Deutschland</small></div>
        </div>

        <form action="https://api.web3forms.com/submit" method="POST" enctype="multipart/form-data" id="contact-form" class="contact-form reveal" data-reveal style="--delay: 100ms">
          <input type="hidden" name="access_key" value="8ac66527-f806-40c3-ae77-5fd812fc2e50" /><input type="hidden" name="subject" value="Neue Projektanfrage – Kollmeier Systems" /><input type="checkbox" name="botcheck" class="sr-only" tabindex="-1" autocomplete="off" />
          <div class="form-row"><label><span>01 / Name *</span><input type="text" name="name" required autocomplete="name" placeholder="Vor- und Nachname" /></label><label><span>02 / E-Mail *</span><input type="email" name="email" required autocomplete="email" placeholder="name@unternehmen.de" /></label></div>
          <label><span>03 / Worum geht es?</span><input type="text" name="betreff" placeholder="z. B. CAD-Konstruktion oder Automatisierung" /></label>
          <label><span>04 / Kurze Projektbeschreibung *</span><textarea name="message" rows="5" required placeholder="Ausgangslage, Ziel und gewünschter Zeitrahmen …"></textarea></label>
          <label class="file-field"><span>05 / Anhang (optional)</span><span class="file-control"><b id="file-label">Datei auswählen</b><small>PDF, PNG, JPG, STEP, DXF oder DWG · max. 25 MB</small><i aria-hidden="true">＋</i></span><input id="attachment" type="file" name="attachment" accept=".pdf,.png,.jpg,.jpeg,.step,.stp,.dxf,.dwg" /></label>
          <div class="form-actions"><p>Mit dem Absenden bestätigst du, die <a href="/datenschutz">Datenschutzerklärung</a> gelesen zu haben.</p><button type="submit" class="button button--contact" id="submit-button">Anfrage senden <span aria-hidden="true">↗</span></button></div>
          <p id="form-status" class="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>

  <footer class="site-footer"><div class="shell footer-grid"><a href="#top" class="brand brand--footer"><svg class="brand-mark" viewBox="0 0 38 38" aria-hidden="true"><path d="M4 4h12v5H9v20h7v5H4zM34 4H22v5h7l-10 9 10 11h-7v5h12V29L24 18l10-9z" /></svg><span class="brand-name">Kollmeier <b>Systems</b></span></a><p>Technische Lösungen, klar entwickelt.</p><div class="footer-links"><a href="/impressum">Impressum</a><a href="/datenschutz">Datenschutz</a></div><small>© {new Date().getFullYear()} Robin Kollmeier</small><a class="back-top" href="#top">Nach oben <span aria-hidden="true">↑</span></a></div></footer>

  <script>
    const header = document.querySelector<HTMLElement>('[data-header]')
    const navToggle = document.querySelector<HTMLButtonElement>('#nav-toggle')
    const navLinks = document.querySelector<HTMLElement>('#nav-links')
    const setMenu = (open: boolean) => { navToggle?.setAttribute('aria-expanded', String(open)); navToggle?.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen'); header?.toggleAttribute('data-menu-open', open); document.body.classList.toggle('menu-open', open) }
    navToggle?.addEventListener('click', () => setMenu(navToggle.getAttribute('aria-expanded') !== 'true'))
    navLinks?.addEventListener('click', (event) => { if ((event.target as HTMLElement).closest('a')) setMenu(false) })
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && navToggle?.getAttribute('aria-expanded') === 'true') { setMenu(false); navToggle.focus() } })
    window.matchMedia('(min-width: 901px)').addEventListener('change', (event) => event.matches && setMenu(false))
    const updateHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 24)
    updateHeader(); window.addEventListener('scroll', updateHeader, { passive: true })

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
    const revealItems = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'))
    if (!reducedMotion.matches && 'IntersectionObserver' in window) {
      document.documentElement.classList.add('motion-ready')
      const observer = new IntersectionObserver((entries) => { entries.forEach((entry) => { if (!entry.isIntersecting) return; entry.target.classList.add('is-visible'); observer.unobserve(entry.target) }) }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' })
      revealItems.forEach((item) => observer.observe(item))
    } else revealItems.forEach((item) => item.classList.add('is-visible'))

    const machine = document.querySelector<HTMLElement>('[data-machine]')
    if (machine && !reducedMotion.matches && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      let frame = 0
      machine.addEventListener('pointermove', (event) => { if (frame) return; frame = requestAnimationFrame(() => { frame = 0; const rect = machine.getBoundingClientRect(); machine.style.setProperty('--mx', `${((event.clientX - rect.left) / rect.width - .5) * 8}px`); machine.style.setProperty('--my', `${((event.clientY - rect.top) / rect.height - .5) * 8}px`) }) })
      machine.addEventListener('pointerleave', () => { machine.style.setProperty('--mx', '0px'); machine.style.setProperty('--my', '0px') })
    }

    const form = document.querySelector<HTMLFormElement>('#contact-form')
    const fileInput = document.querySelector<HTMLInputElement>('#attachment')
    const fileLabel = document.querySelector<HTMLElement>('#file-label')
    const status = document.querySelector<HTMLElement>('#form-status')
    const submitButton = document.querySelector<HTMLButtonElement>('#submit-button')
    fileInput?.addEventListener('change', () => { if (fileLabel) fileLabel.textContent = fileInput.files?.[0]?.name || 'Datei auswählen' })
    form?.addEventListener('submit', async (event) => {
      event.preventDefault(); if (!status || !submitButton) return
      submitButton.disabled = true; submitButton.textContent = 'Wird gesendet …'; status.textContent = ''; status.removeAttribute('data-state')
      try {
        const response = await fetch(form.action, { method: 'POST', body: new FormData(form) }); const result = await response.json()
        if (!response.ok || !result.success) throw new Error('Formular konnte nicht gesendet werden')
        form.reset(); if (fileLabel) fileLabel.textContent = 'Datei auswählen'; status.textContent = 'Danke — deine Anfrage wurde gesendet. Ich melde mich persönlich.'; status.dataset.state = 'success'
      } catch { status.textContent = 'Das Senden hat nicht geklappt. Bitte nutze alternativ die E-Mail-Adresse links.'; status.dataset.state = 'error' }
      finally { submitButton.disabled = false; submitButton.innerHTML = 'Anfrage senden <span aria-hidden="true">↗</span>' }
    })
  </script>
</Layout>
