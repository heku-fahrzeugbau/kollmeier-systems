---
import Layout from '../layouts/Layout.astro'

const services = [
  {
    number: '01',
    title: 'CAD & Konstruktion',
    text: 'Fertigungsgerechte Bauteile, Baugruppen und Sonderlösungen — parametrisch aufgebaut, nachvollziehbar dokumentiert und auf die reale Produktion ausgerichtet.',
    meta: 'SolidWorks · Fusion 360 · DFAM',
  },
  {
    number: '02',
    title: 'Automatisierung',
    text: 'Technische Konzepte und konstruktive Umsetzung für Maschinen, Vorrichtungen und Abläufe, die wiederholbar, wartbar und wirtschaftlich funktionieren.',
    meta: 'Konzept · Konstruktion · Prozess',
  },
  {
    number: '03',
    title: '3D-Druck & Prototyping',
    text: 'Von der Werkstoff- und Verfahrenswahl bis zum belastbaren Prototypen. Mit Fokus auf sinnvolle Anwendungen statt 3D-Druck um jeden Preis.',
    meta: 'FDM · Prototypen · Kleinserien',
  },
  {
    number: '04',
    title: 'Technische KI-Lösungen',
    text: 'KI und Automatisierung für technische Workflows: Daten strukturieren, wiederkehrende Arbeit reduzieren und vorhandenes Wissen nutzbar machen.',
    meta: 'Workflows · Integration · Beratung',
  },
]

const projects = [
  {
    number: '01',
    status: 'Realisiert',
    title: 'Automatisierte Verpackungsanlage',
    text: 'Eigenentwicklung einer Anlage zum Verpacken von Holzplatten mit Pappkartonage und anschließendem Abstapeln auf Europaletten.',
    tags: ['Maschinenbau', 'Automatisierung', 'Palettierung'],
  },
  {
    number: '02',
    status: 'In Entwicklung',
    title: 'Löffel-Sortieranlage',
    text: 'Maßgeschneiderte Förder- und Sortierlösung für einen Spritzgussbetrieb — abgestimmt auf Produktgeometrie und geforderten Durchsatz.',
    tags: ['Konstruktion', 'Fördertechnik', 'Spritzguss'],
  },
  {
    number: '03',
    status: 'Laufend',
    title: 'Produkt- & CAD-Entwicklung',
    text: 'Parametrische Konstruktionen für Maschinenkomponenten, Displays, Marketingartikel und technische Produktvarianten.',
    tags: ['CAD', 'DFAM', 'Produktentwicklung'],
  },
]

const process = [
  ['01', 'Verstehen', 'Aufgabe, Randbedingungen und gewünschtes Ergebnis sauber festhalten.'],
  ['02', 'Entwickeln', 'Lösungswege bewerten und eine belastbare technische Richtung ausarbeiten.'],
  ['03', 'Umsetzen', 'Konstruktion, Prototyp oder Workflow konkret und prüfbar realisieren.'],
  ['04', 'Übergeben', 'Ergebnis dokumentieren, abstimmen und für den Einsatz vorbereiten.'],
]
---

<Layout>
  <header class="site-header">
    <nav class="shell nav" aria-label="Hauptnavigation">
      <a href="#top" class="brand" aria-label="Kollmeier Systems Startseite">
        <span class="brand-mark" aria-hidden="true">KS</span>
        <span>Kollmeier Systems</span>
      </a>
      <div class="nav-links">
        <a href="#leistungen">Leistungen</a>
        <a href="#projekte">Projekte</a>
        <a href="#prozess">Vorgehen</a>
        <a href="#ueber-mich">Über mich</a>
      </div>
      <a href="#kontakt" class="nav-cta">Projekt besprechen <span aria-hidden="true">↗</span></a>
    </nav>
  </header>

  <main id="top">
    <section class="hero">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="shell hero-layout">
        <div class="hero-copy">
          <p class="eyebrow">Engineering aus Bielefeld</p>
          <h1>Aus Ideen werden <em>funktionierende</em> Systeme.</h1>
          <p class="hero-lead">
            Konstruktion, Automatisierung und technische KI-Lösungen für Unternehmen,
            die ein konkretes Problem sauber gelöst brauchen.
          </p>
          <div class="hero-actions">
            <a href="#kontakt" class="button button--signal">Projekt unverbindlich besprechen <span aria-hidden="true">↗</span></a>
            <a href="#projekte" class="button button--ghost">Arbeiten ansehen</a>
          </div>
          <dl class="hero-facts">
            <div><dt>Fokus</dt><dd>CAD · Automation · DFAM</dd></div>
            <div><dt>Arbeitsweise</dt><dd>Direkt · technisch · pragmatisch</dd></div>
          </dl>
        </div>

        <div class="hero-visual">
          <div class="visual-meta"><span>FIELD / 01</span><span>SYSTEMS IN MOTION</span></div>
          <div class="visual-frame">
            <video
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              poster="/videos/hero-ambient-poster.jpg"
              aria-label="Abstrakte technische Animation"
            >
              <source src="/videos/hero-ambient.webm" type="video/webm" />
              <source src="/videos/hero-ambient.mp4" type="video/mp4" />
            </video>
            <div class="visual-overlay"></div>
            <span class="corner corner-a" aria-hidden="true"></span>
            <span class="corner corner-b" aria-hidden="true"></span>
            <div class="visual-caption">
              <span>Idee</span><i aria-hidden="true"></i><span>Entwicklung</span><i aria-hidden="true"></i><strong>Ergebnis</strong>
            </div>
          </div>
        </div>
      </div>
      <div class="shell hero-strip" aria-label="Qualifikationen">
        <span>M.Sc. Wirtschaftsingenieurwesen</span>
        <span>B.Eng. Elektrotechnik</span>
        <span>Zertifizierter KI-Manager</span>
      </div>
    </section>

    <section id="leistungen" class="paper-section services-section">
      <div class="shell">
        <div class="section-intro">
          <div>
            <p class="eyebrow">Leistungen</p>
            <h2 class="section-title">Technik ohne Umwege.</h2>
          </div>
          <p class="section-copy">
            Ich unterstütze dort, wo Konstruktion, Fertigung und digitale Werkzeuge zusammenkommen —
            vom ersten Konzept bis zu einer Lösung, die im Alltag Bestand hat.
          </p>
        </div>

        <div class="service-list">
          {services.map((service) => (
            <article class="service-row">
              <span class="service-number">{service.number}</span>
              <h3>{service.title}</h3>
              <p>{service.text}</p>
              <span class="service-meta">{service.meta}</span>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="projekte" class="projects-section">
      <div class="shell">
        <p class="eyebrow">Ausgewählte Arbeiten</p>
        <div class="projects-heading">
          <h2 class="section-title">Probleme werden Projekte.<br />Projekte werden Lösungen.</h2>
          <p>Ein Einblick in Aufgaben aus Maschinenbau, Automatisierung und Produktentwicklung.</p>
        </div>

        <div class="project-grid">
          {projects.map((project) => (
            <article class="project-card">
              <div class="project-topline">
                <span class="project-number">{project.number}</span>
                <span class="project-status"><i aria-hidden="true"></i>{project.status}</span>
              </div>
              <div class="project-diagram" aria-hidden="true">
                <span class="diagram-node node-a"></span>
                <span class="diagram-node node-b"></span>
                <span class="diagram-node node-c"></span>
                <span class="diagram-line line-a"></span>
                <span class="diagram-line line-b"></span>
              </div>
              <div class="project-content">
                <h3>{project.title}</h3>
                <p>{project.text}</p>
                <ul aria-label="Projektbereiche">
                  {project.tags.map((tag) => <li>{tag}</li>)}
                </ul>
              </div>
            </article>
          ))}
        </div>
        <p class="nda-note">Weitere Arbeiten unterliegen teilweise der Vertraulichkeit und können im persönlichen Gespräch eingeordnet werden.</p>
      </div>
    </section>

    <section id="prozess" class="paper-section process-section">
      <div class="shell process-layout">
        <div class="process-copy">
          <p class="eyebrow">Vorgehen</p>
          <h2 class="section-title">Ein klarer Weg vom Problem zur Lösung.</h2>
          <p class="section-copy">
            Keine aufgeblähten Workshops. Wir klären zuerst, was wirklich gebraucht wird,
            und arbeiten dann in nachvollziehbaren Schritten auf ein nutzbares Ergebnis hin.
          </p>
        </div>
        <ol class="process-list">
          {process.map(([number, title, text]) => (
            <li>
              <span>{number}</span>
              <div><h3>{title}</h3><p>{text}</p></div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="ueber-mich" class="about-section">
      <div class="shell about-layout">
        <div class="about-statement">
          <p class="eyebrow">Über mich</p>
          <h2>Ingenieurdenken trifft digitale Werkzeuge.</h2>
        </div>
        <div class="about-copy">
          <p class="about-lead">Ich bin Robin Kollmeier, Wirtschaftsingenieur und Elektrotechniker aus Bielefeld.</p>
          <p>
            Mein Schwerpunkt liegt dort, wo technische Entwicklung praktisch werden muss:
            in CAD-Modellen, Maschinenkonzepten, Prototypen und automatisierten Abläufen.
            Moderne KI-Werkzeuge setze ich gezielt ein — als Verstärker guter Prozesse, nicht als Selbstzweck.
          </p>
          <div class="about-credentials">
            <div><span>01</span><strong>M.Sc. Wirtschaftsingenieurwesen</strong><small>CAD · Design for Additive Manufacturing</small></div>
            <div><span>02</span><strong>B.Eng. Elektrotechnik</strong><small>Schwerpunkt Automatisierungstechnik</small></div>
            <div><span>03</span><strong>Zertifizierter KI-Manager</strong><small>Technische Prozesse · KI-Integration</small></div>
          </div>
        </div>
      </div>
    </section>

    <section id="kontakt" class="contact-section">
      <div class="shell contact-layout">
        <div class="contact-copy">
          <p class="eyebrow">Kontakt</p>
          <h2>Welches technische Problem soll als Nächstes gelöst werden?</h2>
          <p>Ein paar Stichpunkte reichen für den Anfang. Ich melde mich persönlich und kläre mit dir, ob und wie ich sinnvoll unterstützen kann.</p>
          <div class="contact-direct">
            <span>Direkter Kontakt</span>
            <a href="mailto:kollmeier.robin@gmail.com">kollmeier.robin@gmail.com</a>
            <small>Bielefeld · Deutschland</small>
          </div>
        </div>

        <form
          action="https://api.web3forms.com/submit"
          method="POST"
          enctype="multipart/form-data"
          id="contactForm"
          class="contact-form"
        >
          <input type="hidden" name="access_key" value="8ac66527-f806-40c3-ae77-5fd812fc2e50" />
          <input type="hidden" name="subject" value="Neue Projektanfrage – Kollmeier Systems" />
          <input type="checkbox" name="botcheck" class="sr-only" tabindex="-1" autocomplete="off" />

          <div class="form-grid">
            <label><span>Name *</span><input type="text" name="name" required autocomplete="name" placeholder="Vor- und Nachname" /></label>
            <label><span>E-Mail *</span><input type="email" name="email" required autocomplete="email" placeholder="name@unternehmen.de" /></label>
          </div>
          <label><span>Worum geht es?</span><input type="text" name="betreff" placeholder="z. B. CAD-Konstruktion oder Automatisierung" /></label>
          <label><span>Kurze Projektbeschreibung *</span><textarea name="message" rows="6" required placeholder="Ausgangslage, Ziel und gewünschter Zeitrahmen …"></textarea></label>
          <label class="file-field">
            <span>Anhang (optional)</span>
            <span class="file-button"><b id="fileLabel">Datei auswählen</b><small>PDF, PNG, JPG, STEP, DXF oder DWG · max. 25 MB</small></span>
            <input id="attachment" type="file" name="attachment" accept=".pdf,.png,.jpg,.jpeg,.step,.stp,.dxf,.dwg" />
          </label>
          <div class="form-footer">
            <p>Mit dem Absenden bestätigst du, die <a href="/datenschutz">Datenschutzerklärung</a> gelesen zu haben.</p>
            <button type="submit" class="button button--signal" id="submitButton">Anfrage senden <span aria-hidden="true">↗</span></button>
          </div>
          <p id="formStatus" class="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="shell footer-grid">
      <a href="#top" class="brand"><span class="brand-mark" aria-hidden="true">KS</span><span>Kollmeier Systems</span></a>
      <p>Technische Lösungen, klar entwickelt.</p>
      <div><a href="/impressum">Impressum</a><a href="/datenschutz">Datenschutz</a></div>
      <small>© {new Date().getFullYear()} Robin Kollmeier</small>
    </div>
  </footer>

  <script>
    const form = document.querySelector<HTMLFormElement>('#contactForm')
    const fileInput = document.querySelector<HTMLInputElement>('#attachment')
    const fileLabel = document.querySelector<HTMLElement>('#fileLabel')
    const status = document.querySelector<HTMLElement>('#formStatus')
    const submitButton = document.querySelector<HTMLButtonElement>('#submitButton')

    fileInput?.addEventListener('change', () => {
      if (fileLabel) fileLabel.textContent = fileInput.files?.[0]?.name || 'Datei auswählen'
    })

    form?.addEventListener('submit', async (event) => {
      event.preventDefault()
      if (!status || !submitButton) return

      submitButton.disabled = true
      submitButton.textContent = 'Wird gesendet …'
      status.textContent = ''

      try {
        const response = await fetch(form.action, { method: 'POST', body: new FormData(form) })
        const result = await response.json()
        if (!response.ok || !result.success) throw new Error('Formular konnte nicht gesendet werden')

        form.reset()
        if (fileLabel) fileLabel.textContent = 'Datei auswählen'
        status.textContent = 'Danke — deine Anfrage wurde gesendet. Ich melde mich persönlich.'
        status.dataset.state = 'success'
      } catch {
        status.textContent = 'Das Senden hat nicht geklappt. Bitte nutze alternativ die E-Mail-Adresse links.'
        status.dataset.state = 'error'
      } finally {
        submitButton.disabled = false
        submitButton.innerHTML = 'Anfrage senden <span aria-hidden="true">↗</span>'
      }
    })
  </script>
</Layout>

<style>
  .site-header { position: fixed; inset: 0 0 auto; z-index: 50; border-bottom: 1px solid rgba(255,255,255,.08); background: rgba(11,14,18,.82); backdrop-filter: blur(18px); }
  .nav { min-height: 4.5rem; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 2rem; }
  .brand { display: inline-flex; align-items: center; gap: .7rem; width: max-content; font-size: .88rem; font-weight: 700; letter-spacing: -.02em; }
  .brand-mark { display: grid; width: 2rem; aspect-ratio: 1; place-items: center; border: 1px solid #65707c; font-family: Consolas, monospace; font-size: .68rem; }
  .nav-links { display: flex; align-items: center; gap: 1.7rem; color: #aab0b8; font-size: .8rem; }
  .nav-links a:hover { color: white; }
  .nav-cta { justify-self: end; color: var(--signal); font-size: .82rem; font-weight: 700; }

  .hero { position: relative; min-height: 100svh; overflow: hidden; padding-top: 4.5rem; background: var(--ink); }
  .hero-grid { position: absolute; inset: 0; opacity: .35; background-image: linear-gradient(rgba(255,255,255,.045) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.045) 1px, transparent 1px); background-size: 5rem 5rem; mask-image: linear-gradient(to bottom, black, transparent 82%); }
  .hero-layout { position: relative; display: grid; grid-template-columns: minmax(0,1.08fr) minmax(360px,.92fr); align-items: center; gap: clamp(2rem,6vw,6rem); min-height: calc(100svh - 9rem); padding-block: 5rem 3rem; }
  .hero-copy h1 { max-width: 760px; margin: 1.2rem 0 1.5rem; color: #f6f7f8; font-size: clamp(3.55rem,7.2vw,7.7rem); font-weight: 700; letter-spacing: -.075em; line-height: .87; }
  .hero-copy h1 em { color: var(--signal); font-family: Georgia, serif; font-weight: 400; }
  .hero-lead { max-width: 620px; color: #a5abb3; font-size: clamp(1.05rem,1.7vw,1.32rem); line-height: 1.65; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 2.3rem; }
  .hero-facts { display: flex; gap: 2.5rem; margin: 3rem 0 0; }
  .hero-facts div { padding-left: .8rem; border-left: 1px solid #39414a; }
  .hero-facts dt { color: #747d88; font-family: Consolas, monospace; font-size: .65rem; letter-spacing: .12em; text-transform: uppercase; }
  .hero-facts dd { margin: .35rem 0 0; color: #d7dbe0; font-size: .78rem; }
  .hero-visual { min-width: 0; }
  .visual-meta { display: flex; justify-content: space-between; margin-bottom: .7rem; color: #7f8791; font-family: Consolas, monospace; font-size: .6rem; letter-spacing: .13em; }
  .visual-frame { position: relative; overflow: hidden; aspect-ratio: .83; border: 1px solid #303741; background: #141820; clip-path: polygon(0 0, calc(100% - 2rem) 0, 100% 2rem, 100% 100%, 2rem 100%, 0 calc(100% - 2rem)); }
  .visual-frame video { width: 100%; height: 100%; object-fit: cover; filter: saturate(.65) contrast(1.1); }
  .visual-overlay { position: absolute; inset: 0; background: linear-gradient(160deg, rgba(11,14,18,.05), rgba(11,14,18,.68)); }
  .corner { position: absolute; width: 2rem; height: 2rem; border-color: var(--signal); }
  .corner-a { top: 1.25rem; left: 1.25rem; border-top: 1px solid; border-left: 1px solid; }
  .corner-b { right: 1.25rem; bottom: 1.25rem; border-right: 1px solid; border-bottom: 1px solid; }
  .visual-caption { position: absolute; inset: auto 1.5rem 1.5rem; display: flex; align-items: center; gap: .65rem; padding: .85rem; background: rgba(11,14,18,.74); backdrop-filter: blur(12px); color: #b6bdc6; font-family: Consolas, monospace; font-size: .6rem; letter-spacing: .08em; text-transform: uppercase; }
  .visual-caption i { flex: 1; height: 1px; background: #565f69; }
  .visual-caption strong { color: var(--signal); font-weight: 700; }
  .hero-strip { position: relative; display: flex; justify-content: space-between; gap: 1rem; padding-block: 1.2rem; border-top: 1px solid #282e35; color: #7f8791; font-family: Consolas, monospace; font-size: .68rem; letter-spacing: .06em; text-transform: uppercase; }

  .paper-section { background: var(--paper); color: #111419; }
  .services-section { padding: clamp(6rem,11vw,10rem) 0; }
  .section-intro { display: grid; grid-template-columns: 1.1fr .9fr; align-items: end; gap: 4rem; margin-bottom: 5rem; }
  .service-list { border-top: 1px solid var(--line-light); }
  .service-row { display: grid; grid-template-columns: 4rem 1fr 1.3fr .8fr; gap: 2rem; align-items: start; padding: 2rem 0; border-bottom: 1px solid var(--line-light); }
  .service-number, .service-meta { font-family: Consolas, monospace; font-size: .66rem; letter-spacing: .08em; text-transform: uppercase; }
  .service-number { color: var(--signal); }
  .service-row h3 { margin: 0; font-size: clamp(1.25rem,2vw,1.65rem); letter-spacing: -.035em; }
  .service-row p { margin: 0; color: #5d626a; line-height: 1.65; }
  .service-meta { color: #777d84; line-height: 1.6; }

  .projects-section { padding: clamp(6rem,11vw,10rem) 0; background: #0e1217; }
  .projects-heading { display: grid; grid-template-columns: 1fr 300px; gap: 3rem; align-items: end; margin-bottom: 4.5rem; }
  .projects-heading p { color: #8e96a0; line-height: 1.6; }
  .project-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1rem; }
  .project-card { min-height: 580px; display: flex; flex-direction: column; padding: 1.25rem; border: 1px solid #303740; background: #131820; transition: border-color .25s ease, transform .25s ease; }
  .project-card:hover { transform: translateY(-5px); border-color: #58616d; }
  .project-topline { display: flex; justify-content: space-between; align-items: center; color: #89919b; font-family: Consolas, monospace; font-size: .62rem; letter-spacing: .1em; text-transform: uppercase; }
  .project-number { color: var(--signal); }
  .project-status { display: flex; align-items: center; gap: .5rem; }
  .project-status i { width: .38rem; aspect-ratio: 1; border-radius: 50%; background: var(--signal); box-shadow: 0 0 0 4px rgba(255,96,56,.1); }
  .project-diagram { position: relative; height: 220px; margin: 1.25rem 0 2rem; overflow: hidden; border: 1px solid #272e37; background-image: linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px), linear-gradient(90deg,rgba(255,255,255,.04) 1px,transparent 1px); background-size: 1.5rem 1.5rem; }
  .diagram-node { position: absolute; z-index: 2; width: 2.75rem; aspect-ratio: 1; border: 1px solid #66717d; border-radius: 50%; background: #171d25; }
  .node-a { top: 25%; left: 12%; }
  .node-b { top: 55%; left: 44%; border-radius: 0; transform: rotate(45deg); border-color: var(--signal); }
  .node-c { top: 20%; right: 12%; width: 4rem; }
  .diagram-line { position: absolute; height: 1px; background: #67717c; transform-origin: left center; }
  .line-a { top: 41%; left: 23%; width: 42%; transform: rotate(16deg); }
  .line-b { top: 53%; left: 56%; width: 34%; transform: rotate(-27deg); }
  .project-content { margin-top: auto; }
  .project-content h3 { margin: 0 0 .8rem; color: white; font-size: 1.35rem; letter-spacing: -.035em; }
  .project-content p { min-height: 5.5rem; margin: 0; color: #939ba5; font-size: .9rem; line-height: 1.65; }
  .project-content ul { display: flex; flex-wrap: wrap; gap: .45rem; margin: 1.5rem 0 0; padding: 0; list-style: none; }
  .project-content li { padding: .38rem .55rem; border: 1px solid #323a44; color: #9da5af; font-family: Consolas, monospace; font-size: .58rem; letter-spacing: .05em; text-transform: uppercase; }
  .nda-note { margin: 2rem 0 0; color: #69717b; font-size: .72rem; }

  .process-section { padding: clamp(6rem,11vw,10rem) 0; }
  .process-layout { display: grid; grid-template-columns: .85fr 1.15fr; gap: clamp(3rem,9vw,9rem); }
  .process-copy { position: sticky; top: 8rem; align-self: start; }
  .process-copy .section-copy { margin-top: 2rem; }
  .process-list { margin: 0; padding: 0; border-top: 1px solid var(--line-light); list-style: none; }
  .process-list li { display: grid; grid-template-columns: 3.5rem 1fr; gap: 1rem; padding: 2rem 0; border-bottom: 1px solid var(--line-light); }
  .process-list > li > span { color: var(--signal); font-family: Consolas, monospace; font-size: .72rem; }
  .process-list h3 { margin: 0 0 .5rem; font-size: 1.45rem; letter-spacing: -.035em; }
  .process-list p { max-width: 560px; margin: 0; color: #646970; line-height: 1.65; }

  .about-section { padding: clamp(6rem,11vw,10rem) 0; overflow: hidden; background: var(--blueprint); color: #090c10; }
  .about-layout { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(3rem,9vw,9rem); }
