---
import Layout from '../layouts/Layout.astro'

const services = [
  {
    number: '01',
    title: 'CAD & Konstruktion',
    text: 'Fertigungsgerechte Bauteile, Baugruppen und Sonderlösungen — parametrisch aufgebaut, nachvollziehbar dokumentiert und auf die reale Produktion ausgerichtet.',
    meta: 'SolidWorks · Fusion 360 · DFAM',
  },
  {
    number: '02',
    title: 'Automatisierung',
    text: 'Technische Konzepte und konstruktive Umsetzung für Maschinen, Vorrichtungen und Abläufe, die wiederholbar, wartbar und wirtschaftlich funktionieren.',
    meta: 'Konzept · Konstruktion · Prozess',
  },
  {
    number: '03',
    title: '3D-Druck & Prototyping',
    text: 'Von der Werkstoff- und Verfahrenswahl bis zum belastbaren Prototypen. Mit Fokus auf sinnvolle Anwendungen statt 3D-Druck um jeden Preis.',
    meta: 'FDM · Prototypen · Kleinserien',
  },
  {
    number: '04',
    title: 'Technische KI-Lösungen',
    text: 'KI und Automatisierung für technische Workflows: Daten strukturieren, wiederkehrende Arbeit reduzieren und vorhandenes Wissen nutzbar machen.',
    meta: 'Workflows · Integration · Beratung',
  },
]

const projects = [
  {
    number: '01',
    status: 'Realisiert',
    title: 'Automatisierte Verpackungsanlage',
    text: 'Eigenentwicklung einer Anlage zum Verpacken von Holzplatten mit Pappkartonage und anschließendem Abstapeln auf Europaletten.',
    tags: ['Maschinenbau', 'Automatisierung', 'Palettierung'],
  },
  {
    number: '02',
    status: 'In Entwicklung',
    title: 'Löffel-Sortieranlage',
    text: 'Maßgeschneiderte Förder- und Sortierlösung für einen Spritzgussbetrieb — abgestimmt auf Produktgeometrie und geforderten Durchsatz.',
    tags: ['Konstruktion', 'Fördertechnik', 'Spritzguss'],
  },
  {
    number: '03',
    status: 'Laufend',
    title: 'Produkt- & CAD-Entwicklung',
    text: 'Parametrische Konstruktionen für Maschinenkomponenten, Displays, Marketingartikel und technische Produktvarianten.',
    tags: ['CAD', 'DFAM', 'Produktentwicklung'],
  },
]

const process = [
  ['01', 'Verstehen', 'Aufgabe, Randbedingungen und gewünschtes Ergebnis sauber festhalten.'],
  ['02', 'Entwickeln', 'Lösungswege bewerten und eine belastbare technische Richtung ausarbeiten.'],
  ['03', 'Umsetzen', 'Konstruktion, Prototyp oder Workflow konkret und prüfbar realisieren.'],
  ['04', 'Übergeben', 'Ergebnis dokumentieren, abstimmen und für den Einsatz vorbereiten.'],
]
---

<Layout>
  <header class="site-header">
    <nav class="shell nav" aria-label="Hauptnavigation">
      <a href="#top" class="brand" aria-label="Kollmeier Systems Startseite">
        <span class="brand-mark" aria-hidden="true">KS</span>
        <span>Kollmeier Systems</span>
      </a>
      <div class="nav-links" id="nav-links">
        <a href="#leistungen">Leistungen</a>
        <a href="#projekte">Projekte</a>
        <a href="#prozess">Vorgehen</a>
        <a href="#ueber-mich">Über mich</a>
      </div>
      <a href="#kontakt" class="nav-cta">Projekt besprechen <span aria-hidden="true">↗</span></a>
      <button
        type="button"
        class="nav-toggle"
        id="navToggle"
        aria-expanded="false"
        aria-controls="nav-links"
        aria-label="Menü öffnen"
      >
        <span aria-hidden="true"></span>
      </button>
    </nav>
  </header>

  <main id="top">
    <section class="hero">
      <div class="hero-ambient" aria-hidden="true">
        <video autoplay muted loop playsinline preload="metadata" poster="/videos/hero-ambient-poster.jpg">
          <source src="/videos/hero-ambient.webm" type="video/webm" />
          <source src="/videos/hero-ambient.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="hero-veil" aria-hidden="true"></div>
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="shell hero-layout">
        <div class="hero-copy">
          <p class="eyebrow hero-enter" style="--enter-delay: 60ms">Engineering aus Bielefeld</p>
          <h1 class="hero-enter" style="--enter-delay: 120ms">Aus Ideen werden <em>funktionierende</em> Systeme.</h1>
          <p class="hero-lead hero-enter" style="--enter-delay: 190ms">
            Konstruktion, Automatisierung und technische KI-Lösungen für Unternehmen,
            die ein konkretes Problem sauber gelöst brauchen.
          </p>
          <div class="hero-actions hero-enter" style="--enter-delay: 260ms">
            <a href="#kontakt" class="button button--signal">Projekt unverbindlich besprechen <span aria-hidden="true">↗</span></a>
            <a href="#projekte" class="button button--ghost">Arbeiten ansehen</a>
          </div>
          <dl class="hero-facts hero-enter" style="--enter-delay: 330ms">
            <div><dt>Fokus</dt><dd>CAD · Automation · DFAM</dd></div>
            <div><dt>Arbeitsweise</dt><dd>Direkt · technisch · pragmatisch</dd></div>
          </dl>
        </div>

        <div class="hero-visual hero-enter" style="--enter-delay: 200ms">
          <div class="visual-meta"><span>FIELD / 01</span><span>SYSTEMS IN MOTION</span></div>
          <div class="visual-frame">
            <img
              src="/videos/hero-ambient-poster.jpg"
              width="1920"
              height="1080"
              alt="Abstrakte technische Licht- und Rasterstruktur"
              fetchpriority="high"
            />
            <div class="visual-overlay"></div>
            <div class="visual-3d" aria-hidden="true">
              <div class="cube">
                <span class="face face-front"></span>
                <span class="face face-back"></span>
                <span class="face face-right"></span>
                <span class="face face-left"></span>
                <span class="face face-top"></span>
                <span class="face face-bottom"></span>
                <span class="axis axis-x"></span>
                <span class="axis axis-y"></span>
                <span class="axis axis-z"></span>
              </div>
            </div>
            <span class="corner corner-a" aria-hidden="true"></span>
            <span class="corner corner-b" aria-hidden="true"></span>
            <div class="visual-caption">
              <span>Idee</span><i aria-hidden="true"></i><span>Entwicklung</span><i aria-hidden="true"></i><strong>Ergebnis</strong>
            </div>
          </div>
        </div>
      </div>
      <div class="shell hero-strip hero-enter" style="--enter-delay: 400ms" aria-label="Qualifikationen">
        <span>M.Sc. Wirtschaftsingenieurwesen</span>
        <span>B.Eng. Elektrotechnik</span>
        <span>Zertifizierter KI-Manager</span>
      </div>
    </section>

    <section id="leistungen" class="paper-section services-section">
      <div class="shell">
        <div class="section-intro reveal-item" data-reveal>
          <div>
            <p class="eyebrow">Leistungen</p>
            <h2 class="section-title">Technik ohne Umwege.</h2>
          </div>
          <p class="section-copy">
            Ich unterstütze dort, wo Konstruktion, Fertigung und digitale Werkzeuge zusammenkommen —
            vom ersten Konzept bis zu einer Lösung, die im Alltag Bestand hat.
          </p>
        </div>

        <div class="service-list">
          {services.map((service, index) => (
            <article class="service-row reveal-item" data-reveal style={`--reveal-delay: ${index * 70}ms`}>
              <span class="service-number">{service.number}</span>
              <h3>{service.title}</h3>
              <p>{service.text}</p>
              <span class="service-meta">{service.meta}</span>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="projekte" class="projects-section">
      <div class="shell">
        <p class="eyebrow">Ausgewählte Arbeiten</p>
        <div class="projects-heading reveal-item" data-reveal>
          <h2 class="section-title">Probleme werden Projekte.<br />Projekte werden Lösungen.</h2>
          <p>Ein Einblick in Aufgaben aus Maschinenbau, Automatisierung und Produktentwicklung.</p>
        </div>

        <div class="project-grid">
          {projects.map((project, index) => (
            <article class="project-card reveal-item" data-reveal style={`--reveal-delay: ${index * 90}ms`}>
              <div class="project-topline">
                <span class="project-number">{project.number}</span>
                <span class="project-status"><i aria-hidden="true"></i>{project.status}</span>
              </div>
              <div class="project-diagram" aria-hidden="true">
                <span class="diagram-node node-a"></span>
                <span class="diagram-node node-b"></span>
                <span class="diagram-node node-c"></span>
                <span class="diagram-line line-a"></span>
                <span class="diagram-line line-b"></span>
              </div>
              <div class="project-content">
                <h3>{project.title}</h3>
                <p>{project.text}</p>
                <ul aria-label="Projektbereiche">
                  {project.tags.map((tag) => <li>{tag}</li>)}
                </ul>
              </div>
            </article>
          ))}
        </div>
        <p class="nda-note">Weitere Arbeiten unterliegen teilweise der Vertraulichkeit und können im persönlichen Gespräch eingeordnet werden.</p>
      </div>
    </section>

    <section id="prozess" class="paper-section process-section">
      <div class="shell process-layout">
        <div class="process-copy reveal-item" data-reveal>
          <p class="eyebrow">Vorgehen</p>
          <h2 class="section-title">Ein klarer Weg vom Problem zur Lösung.</h2>
          <p class="section-copy">
            Keine aufgeblähten Workshops. Wir klären zuerst, was wirklich gebraucht wird,
            und arbeiten dann in nachvollziehbaren Schritten auf ein nutzbares Ergebnis hin.
          </p>
        </div>
        <ol class="process-list">
          {process.map(([number, title, text], index) => (
            <li class="reveal-item" data-reveal style={`--reveal-delay: ${index * 70}ms`}>
              <span>{number}</span>
              <div><h3>{title}</h3><p>{text}</p></div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="ueber-mich" class="about-section">
      <div class="shell about-layout">
        <div class="about-statement reveal-item" data-reveal>
          <p class="eyebrow">Über mich</p>
          <h2>Ingenieurdenken trifft digitale Werkzeuge.</h2>
        </div>
        <div class="about-copy reveal-item" data-reveal style="--reveal-delay: 110ms">
          <p class="about-lead">Ich bin Robin Kollmeier, Wirtschaftsingenieur und Elektrotechniker aus Bielefeld.</p>
          <p>
            Mein Schwerpunkt liegt dort, wo technische Entwicklung praktisch werden muss:
            in CAD-Modellen, Maschinenkonzepten, Prototypen und automatisierten Abläufen.
            Moderne KI-Werkzeuge setze ich gezielt ein — als Verstärker guter Prozesse, nicht als Selbstzweck.
          </p>
          <div class="about-credentials">
            <div><span>01</span><strong>M.Sc. Wirtschaftsingenieurwesen</strong><small>CAD · Design for Additive Manufacturing</small></div>
            <div><span>02</span><strong>B.Eng. Elektrotechnik</strong><small>Schwerpunkt Automatisierungstechnik</small></div>
            <div><span>03</span><strong>Zertifizierter KI-Manager</strong><small>Technische Prozesse · KI-Integration</small></div>
          </div>
        </div>
      </div>
    </section>

    <section id="kontakt" class="contact-section">
      <div class="shell contact-layout">
        <div class="contact-copy reveal-item" data-reveal>
          <p class="eyebrow">Kontakt</p>
          <h2>Welches technische Problem soll als Nächstes gelöst werden?</h2>
          <p>Ein paar Stichpunkte reichen für den Anfang. Ich melde mich persönlich und kläre mit dir, ob und wie ich sinnvoll unterstützen kann.</p>
          <div class="contact-direct">
            <span>Direkter Kontakt</span>
            <a href="mailto:kollmeier.robin@gmail.com">kollmeier.robin@gmail.com</a>
            <small>Bielefeld · Deutschland</small>
          </div>
        </div>

        <form
          action="https://api.web3forms.com/submit"
          method="POST"
          enctype="multipart/form-data"
          id="contactForm"
          class="contact-form reveal-item"
          data-reveal
          style="--reveal-delay: 120ms"
        >
          <input type="hidden" name="access_key" value="8ac66527-f806-40c3-ae77-5fd812fc2e50" />
          <input type="hidden" name="subject" value="Neue Projektanfrage – Kollmeier Systems" />
          <input type="checkbox" name="botcheck" class="sr-only" tabindex="-1" autocomplete="off" />

          <div class="form-grid">
            <label><span>Name *</span><input type="text" name="name" required autocomplete="name" placeholder="Vor- und Nachname" /></label>
            <label><span>E-Mail *</span><input type="email" name="email" required autocomplete="email" placeholder="name@unternehmen.de" /></label>
          </div>
          <label><span>Worum geht es?</span><input type="text" name="betreff" placeholder="z. B. CAD-Konstruktion oder Automatisierung" /></label>
          <label><span>Kurze Projektbeschreibung *</span><textarea name="message" rows="6" required placeholder="Ausgangslage, Ziel und gewünschter Zeitrahmen …"></textarea></label>
          <label class="file-field">
            <span>Anhang (optional)</span>
            <span class="file-button"><b id="fileLabel">Datei auswählen</b><small>PDF, PNG, JPG, STEP, DXF oder DWG · max. 25 MB</small></span>
            <input id="attachment" type="file" name="attachment" accept=".pdf,.png,.jpg,.jpeg,.step,.stp,.dxf,.dwg" />
          </label>
          <div class="form-footer">
            <p>Mit dem Absenden bestätigst du, die <a href="/datenschutz">Datenschutzerklärung</a> gelesen zu haben.</p>
            <button type="submit" class="button button--signal" id="submitButton">Anfrage senden <span aria-hidden="true">↗</span></button>
          </div>
          <p id="formStatus" class="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="shell footer-grid">
      <a href="#top" class="brand"><span class="brand-mark" aria-hidden="true">KS</span><span>Kollmeier Systems</span></a>
      <p>Technische Lösungen, klar entwickelt.</p>
      <div><a href="/impressum">Impressum</a><a href="/datenschutz">Datenschutz</a></div>
      <small>© {new Date().getFullYear()} Robin Kollmeier</small>
    </div>
  </footer>

  <script>
    const form = document.querySelector<HTMLFormElement>('#contactForm')
    const fileInput = document.querySelector<HTMLInputElement>('#attachment')
    const fileLabel = document.querySelector<HTMLElement>('#fileLabel')
    const status = document.querySelector<HTMLElement>('#formStatus')
    const submitButton = document.querySelector<HTMLButtonElement>('#submitButton')

    fileInput?.addEventListener('change', () => {
      if (fileLabel) fileLabel.textContent = fileInput.files?.[0]?.name || 'Datei auswählen'
    })

    form?.addEventListener('submit', async (event) => {
      event.preventDefault()
      if (!status || !submitButton) return

      submitButton.disabled = true
      submitButton.textContent = 'Wird gesendet …'
      status.textContent = ''

      try {
        const response = await fetch(form.action, { method: 'POST', body: new FormData(form) })
        const result = await response.json()
        if (!response.ok || !result.success) throw new Error('Formular konnte nicht gesendet werden')

        form.reset()
        if (fileLabel) fileLabel.textContent = 'Datei auswählen'
        status.textContent = 'Danke — deine Anfrage wurde gesendet. Ich melde mich persönlich.'
        status.dataset.state = 'success'
      } catch {
        status.textContent = 'Das Senden hat nicht geklappt. Bitte nutze alternativ die E-Mail-Adresse links.'
        status.dataset.state = 'error'
      } finally {
        submitButton.disabled = false
        submitButton.innerHTML = 'Anfrage senden <span aria-hidden="true">↗</span>'
      }
    })

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
    const revealItems = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'))

    if (!reducedMotion.matches && 'IntersectionObserver' in window) {
      document.documentElement.classList.add('motion-enabled')
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return
            entry.target.classList.add('is-visible')
            revealObserver.unobserve(entry.target)
          })
        },
        { threshold: 0.14, rootMargin: '0px 0px -8% 0px' },
      )
      revealItems.forEach((item) => revealObserver.observe(item))
    } else {
      revealItems.forEach((item) => item.classList.add('is-visible'))
    }

    const siteHeader = document.querySelector<HTMLElement>('.site-header')
    const updateHeader = () => siteHeader?.classList.toggle('is-scrolled', window.scrollY > 18)
    updateHeader()
    window.addEventListener('scroll', updateHeader, { passive: true })

    const navToggle = document.querySelector<HTMLButtonElement>('#navToggle')
    const navLinks = document.querySelector<HTMLElement>('#nav-links')

    const setMenu = (open: boolean) => {
      if (!siteHeader || !navToggle) return
      navToggle.setAttribute('aria-expanded', String(open))
      navToggle.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen')
      siteHeader.toggleAttribute('data-menu-open', open)
    }

    navToggle?.addEventListener('click', () => {
      setMenu(navToggle.getAttribute('aria-expanded') !== 'true')
    })

    navLinks?.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setMenu(false)
    })

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return
      if (navToggle?.getAttribute('aria-expanded') !== 'true') return
      setMenu(false)
      navToggle.focus()
    })

    // Menü schließen, wenn der Breakpoint zurück auf Desktop wechselt
    const desktopNav = window.matchMedia('(min-width: 981px)')
    desktopNav.addEventListener('change', (event) => {
      if (event.matches) setMenu(false)
    })

    const hero = document.querySelector<HTMLElement>('.hero')
    const visualFrame = document.querySelector<HTMLElement>('.visual-frame')
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)')

    if (hero && visualFrame && finePointer.matches && !reducedMotion.matches) {
      // Auf einen Frame pro Repaint gedrosselt statt bei jedem Pointer-Event zu schreiben
      let pending = 0
      hero.addEventListener('pointermove', (event) => {
        if (pending) return
        pending = requestAnimationFrame(() => {
          pending = 0
          const bounds = hero.getBoundingClientRect()
          const x = (event.clientX - bounds.left) / bounds.width - 0.5
          const y = (event.clientY - bounds.top) / bounds.height - 0.5
          visualFrame.style.setProperty('--tilt-x', `${x * 2.4}deg`)
          visualFrame.style.setProperty('--tilt-y', `${y * -2.4}deg`)
        })
      })
      hero.addEventListener('pointerleave', () => {
        visualFrame.style.setProperty('--tilt-x', '0deg')
        visualFrame.style.setProperty('--tilt-y', '0deg')
      })
    }

    // Video und 3D-Würfel anhalten, sobald der Hero aus dem Viewport ist — spart Akku und GPU
    const heroVideo = document.querySelector<HTMLVideoElement>('.hero-ambient video')
    const cube = document.querySelector<HTMLElement>('.cube')
    if (hero && 'IntersectionObserver' in window) {
      new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) heroVideo?.play().catch(() => {})
          else heroVideo?.pause()
          if (cube) cube.style.animationPlayState = entry.isIntersecting ? 'running' : 'paused'
        },
        { threshold: 0 },
      ).observe(hero)
    }
  </script>
</Layout>

<style>
  .site-header { position: fixed; inset: 0 0 auto; z-index: 50; border-bottom: 1px solid rgba(255,255,255,.08); background: rgba(0,0,0,.58); backdrop-filter: blur(18px); transition: background-color var(--dur-enter) var(--ease-out), border-color var(--dur-enter) var(--ease-out), box-shadow var(--dur-enter) var(--ease-out); }
  .site-header.is-scrolled { border-color: rgba(255,255,255,.13); background: rgba(0,0,0,.84); box-shadow: 0 12px 40px rgba(0,0,0,.18); }
  .nav { min-height: 4.5rem; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 2rem; }
  .brand { display: inline-flex; align-items: center; gap: .7rem; width: max-content; padding-block: .6rem; font-size: .88rem; font-weight: 700; letter-spacing: -.02em; }
  .brand-mark { display: grid; width: 2rem; aspect-ratio: 1; place-items: center; border: 1px solid #65707c; font-family: Consolas, monospace; font-size: .75rem; }
  .nav-links { display: flex; align-items: center; gap: 1.7rem; color: #aab0b8; font-size: .82rem; }
  .nav-links a { padding-block: .8rem; transition: color var(--dur-hover) var(--ease-out); }
  .nav-cta { justify-self: end; padding-block: .8rem; color: var(--signal); font-size: .82rem; font-weight: 700; transition: color var(--dur-hover) var(--ease-out); }
  .nav-cta:active { color: #ff8c6d; }
  .nav-toggle { display: none; }

  @media (hover: hover) and (pointer: fine) {
    .nav-links a:hover { color: white; }
    .nav-cta:hover { color: #ff8c6d; }
  }

  .hero { position: relative; min-height: 100svh; overflow: hidden; padding-top: 4.5rem; isolation: isolate; }
  /* Kein deckendes Poster mehr: das Video liegt bei 22% über dem Sternenfeld. */
  .hero-ambient { position: absolute; inset: 0; z-index: 0; overflow: hidden; }
  .hero-ambient video { width: 100%; height: 100%; object-fit: cover; opacity: .22; filter: saturate(.72) contrast(1.08); transform: scale(1.04); }
  /* Nur noch so viel Schleier, wie der Text zum Lesen braucht. */
  .hero-veil { position: absolute; inset: 0; z-index: 1; background: linear-gradient(90deg, rgba(0,0,0,.58) 0%, rgba(0,0,0,.28) 46%, rgba(0,0,0,.06) 100%), linear-gradient(0deg, rgba(0,0,0,.52) 0%, transparent 46%); }
  .hero-grid { position: absolute; inset: -5rem; z-index: 2; opacity: .14; background-image: linear-gradient(rgba(255,255,255,.045) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.045) 1px, transparent 1px); background-size: 5rem 5rem; mask-image: linear-gradient(to bottom, black, transparent 82%); animation: grid-drift 42s linear infinite; }
  .hero-layout { position: relative; z-index: 3; display: grid; grid-template-columns: minmax(0,1.08fr) minmax(360px,.92fr); align-items: center; gap: clamp(2rem,6vw,6rem); min-height: calc(100svh - 9rem); padding-block: 5rem 3rem; }
  .hero-enter { opacity: 0; animation: hero-enter .6s var(--ease-out) forwards; animation-delay: var(--enter-delay, 0ms); }
  /*
    Obergrenze 6.5rem statt 7.7rem: "funktionierende" ist in Georgia Italic rund
    6,0x so breit wie die Schriftgröße und damit breiter als die Hero-Spalte. Es ragt
    bewusst in die Rasterlücke, lief bei 1920px aber 59px unter das rechte Panel.
  */
  .hero-copy h1 { max-width: 760px; margin: 1.2rem 0 1.5rem; color: #f6f7f8; font-size: clamp(3.55rem,7.2vw,6.5rem); font-weight: 700; letter-spacing: -.048em; line-height: .94; }
  .hero-copy h1 em { color: var(--signal); font-family: Georgia, serif; font-weight: 400; }
  .hero-lead { max-width: 620px; color: #a5abb3; font-size: clamp(1.05rem,1.7vw,1.32rem); line-height: 1.65; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 2.3rem; }
  .hero-facts { display: flex; gap: 2.5rem; margin: 3rem 0 0; }
